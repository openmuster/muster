{
  "name": "muster-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": { "node": "^22.22.3 || >=24.15" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings",
    "knip": "knip",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm knip && pnpm test",
    "test:browser": "pnpm build && pnpm --filter @openmuster/muster test:browser"
  },
  "devDependencies": {
    "knip": "^6.48.0",
    "oxlint": "^1.95.0"
  }
}

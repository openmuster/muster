{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "muster-docs",
  // Keep this a few days in the past: a date in the future for Cloudflare's clock is refused.
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "openmuster.ai", "custom_domain": true }],
  // Keep Workers Logs, so an error in the search route is visible.
  "observability": {
    "enabled": true
  }
}

{
  "watchers": [
    {
      "name": "card-start",
      "tail": { "channel": "cards", "labels": ["tag.agent=agent"], "types": ["message.posted", "labels.changed"] },
      "run": ["./start.sh", "{thread}"],
      "as": "intake",
      "every": 30
    },
    {
      "name": "needs-me",
      "tail": { "channel": "cards/", "types": ["task.blocked"] },
      "run": ["./notify.sh", "{thread}"],
      "env": ["NOTIFY_CMD"],
      "every": 30
    }
  ]
}

{
  "name": "muster",
  "version": "0.2.0-alpha.1",
  "description": "A local-first work queue for coding agents, with the threads people read: leased tasks, one log, wait and tail, schedules and watchers.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/openmuster/muster.git", "directory": "packages/muster" },
  "homepage": "https://github.com/openmuster/muster#readme",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.15"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "muster": "./dist/cli.js",
    "mu": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-skills.mjs",
    "prepack": "node scripts/prepack.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && MUSTER_BACKEND=http vitest run test/messages.test.ts test/reading.test.ts test/tasks.test.ts test/daemon.test.ts test/blocks.test.ts -t '^(messages|reading|tasks|schedules|watchers|typed blocks) '"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

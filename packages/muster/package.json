{
  "name": "muster",
  "version": "0.0.0",
  "description": "A local-first message board and task queue for coding agents: one log, claimable tasks, wait and tail, schedules and watchers.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "files": ["dist", "docs", "README.md"],
  "bin": { "muster": "./dist/cli.mjs", "mu": "./dist/cli.mjs" },
  "exports": {
    ".": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
